# Microsoft Playwright Workspaces (PWW) — region + workspace ID
# Get these from the Azure portal under your Playwright Workspaces resource.
PLAYWRIGHT_SERVICE_URL="wss://<region>.api.playwright.microsoft.com/playwrightworkspaces/<workspace-id>/browsers"
PLAYWRIGHT_SERVICE_ACCESS_TOKEN="<your-pww-access-token>"

# Authenticated forward proxy (deploy from ./proxy-server, or use your own).
PROXY_SERVER="http://<your-proxy-fqdn>:8080"
PROXY_USERNAME="<your-proxy-user>"
PROXY_PASSWORD="<your-proxy-password>"
